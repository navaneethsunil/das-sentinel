# DAS Sentinel — environment template (M0-I3).
# Copy to `.env` and fill in values. PLACEHOLDERS ONLY in this file — never commit
# real secrets (CLAUDE.md §5, TRD TR-23). `.env` is gitignored.
#
# docker compose reads this file automatically; the API/worker load the same vars
# through the single `Settings` object in `apps/api/app/core/config.py`.

# ─── App ────────────────────────────────────────────────────────────────────
# dev | test | prod
DAS_ENV=dev
LOG_LEVEL=INFO
# FastAPI root_path behind the Caddy proxy (M0-B1 / M0-I4)
API_ROOT_PATH=/api
# Interactive API docs (Swagger/ReDoc/openapi.json). Fail-safe OFF in code — on
# here for dev convenience; leave UNSET (or false) in prod (SEC-DEBT-7).
EXPOSE_API_DOCS=true
# argon2id (OWASP default) | pbkdf2_sha256 (FIPS fallback — flip only if the
# target ATO mandates FIPS-validated password storage; existing hashes keep
# verifying and upgrade on next login) (M1-B1)
PASSWORD_HASH_SCHEME=argon2id
# Login anti-brute-force (M1-SEC5): Valkey-backed failure counters over a
# rolling window, per-IP (primary gate) and per-account (temporary throttle).
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_PER_IP=30
LOGIN_RATE_LIMIT_MAX_PER_EMAIL=5
# API abuse controls (IMPLEMENTATION_PLAN §9 item 5). Per-user throttle on
# state-changing requests (reads exempt; generous; <=0 disables) + concurrent-
# scan caps (fail-closed at launch; <=0 disables that scope).
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_PER_USER=300
MAX_CONCURRENT_SCANS_PER_ENGAGEMENT=5
MAX_CONCURRENT_SCANS_PER_ORG=20

# Scan orchestration (M2-W2): worker cancel-flag poll / heartbeat cadence, in
# seconds. Coarse bound on how fast emergency stop halts an in-flight run.
SCAN_CANCEL_POLL_SECONDS=2.0

# ─── PostgreSQL (compose service `postgres` + API) ──────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Owner/DDL role: runs migrations, owns tables, admin cleanup.
POSTGRES_USER=dassentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dassentinel
# Least-privilege runtime role (SEC-DEBT-4). Setting POSTGRES_APP_PASSWORD makes
# the role migration provision POSTGRES_APP_USER (SELECT/INSERT only on the
# append-only audit/evidence tables). Set POSTGRES_USE_APP_ROLE=true in prod so
# the app/worker connect as it; migrations always run as POSTGRES_USER above.
POSTGRES_APP_USER=das_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_USE_APP_ROLE=false

# ─── Valkey (compose service `valkey`) ──────────────────────────────────────
# Celery URLs use the redis:// scheme (protocol-compatible — M0-W1).
VALKEY_HOST=valkey
VALKEY_PORT=6379
# Separate logical DBs: broker / results / cache / sessions (M0-W1, M1-B2)
VALKEY_DB_BROKER=0
VALKEY_DB_RESULTS=1
VALKEY_DB_CACHE=2
VALKEY_DB_SESSIONS=3

# ─── MinIO — DEV-ONLY evidence store (ROADMAP evidence-backend gate) ────────
# Image is digest-pinned in docker-compose.yml (TR-25) — no tag override here.
# Server root credentials (compose service `minio`)
MINIO_ROOT_USER=dassentinel
MINIO_ROOT_PASSWORD=change-me
# API-side client config; internal endpoint, plaintext inside the compose network
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
EVIDENCE_BUCKET=evidence
# Optional scoped client credentials for the API — if unset, the Settings object
# falls back to the root credentials above (acceptable in dev only).
#MINIO_ACCESS_KEY=
#MINIO_SECRET_KEY=
# WORM retention (days) applied as COMPLIANCE object-lock to every stored blob.
# 0 = off (dev, blobs stay deletable). Set > 0 only against a WORM-verified
# backend at go-live — it makes evidence undeletable until it expires.
EVIDENCE_WORM_RETENTION_DAYS=0

# ─── Web (compose service `web`) ────────────────────────────────────────────
# Server-side (RSC) API base — compose-internal, never exposed to the browser.
# Browser requests go same-origin via the proxy (/api → api, M0-I4).
API_INTERNAL_URL=http://api:8000

# ─── LLM (provider abstraction — CLAUDE.md §7; wired in M2) ─────────────────
# anthropic | ollama | vllm
LLM_PROVIDER=anthropic
# Required only when LLM_PROVIDER=anthropic; leave empty otherwise.
ANTHROPIC_API_KEY=
# Model routing (no model names hardcoded in code)
LLM_MODEL_DEFAULT=claude-opus-4-8
LLM_MODEL_TRIAGE=claude-sonnet-5
LLM_MODEL_CLASSIFIER=claude-haiku-4-5
# Local backends (optional; required when the matching LLM_PROVIDER is selected)
#OLLAMA_BASE_URL=http://ollama:11434
#VLLM_BASE_URL=http://vllm:8000
# Per-engagement LLM budget ceiling (M2-SEC4, TM-12), fail-closed. Summed from the
# engagement's llm_interactions. Tokens bound total work (local + hosted); cost
# bounds hosted spend. A value <= 0 disables that ceiling (cost is off by default).
LLM_MAX_TOKENS_PER_ENGAGEMENT=2000000
LLM_MAX_COST_USD_PER_ENGAGEMENT=0

# ─── Egress shaper (M2-SEC1, TM-1) ─────────────────────────────────────────
# Comma-separated host / host:port of operator-trusted model provider endpoints
# run traffic may reach even though they are not engagement targets. Everything
# else is default-deny (in-scope target IPs only). Empty by default.
EGRESS_PROVIDER_ALLOWLIST=

# ─── ZAP DAST scanner (M3-W3) ──────────────────────────────────────────────
# The ZAP daemon runs as a digest-pinned container on the internal network; the
# adapter drives it over its API. ZAP_API_KEY is a runtime secret shared by the
# daemon and the adapter — it is NEVER persisted into scanner_runs.config,
# evidence, logs, or exports. Set a strong random value in real deployments.
ZAP_API_URL=http://zap:8090
ZAP_API_KEY=change-me
ZAP_IMAGE_DIGEST=ghcr.io/zaproxy/zaproxy@sha256:8d387b1a63e3425beef4846e39719f5af2a787753af2d8b6558c6257d7a577a2

# ─── MFA / TOTP (SEC-DEBT-2) ────────────────────────────────────────────────
# Fernet key encrypting each user's TOTP secret at rest. Optional: unset falls
# back to a fixed dev key outside prod; in prod, a user enrolling MFA with no
# key set fails closed. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#MFA_SECRET_ENCRYPTION_KEY=
#MFA_ISSUER=DAS Sentinel
