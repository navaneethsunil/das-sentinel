# DAS Sentinel reverse proxy (M0-I4).
#
# Single ingress on :443 (TR-4):
#   - `/api/*` -> api:8000  (prefix stripped; FastAPI runs with root_path="/api")
#   - `/`      -> web:3000  (Next.js; `flush_interval -1` so RSC/streaming responses
#                            are flushed immediately — Caddy has no `proxy_buffering`
#                            directive, that is nginx)
#   - security headers per TRD TR-24 on every response
#
# Forwarded headers: Caddy's reverse_proxy sets X-Forwarded-For, X-Forwarded-Proto
# and X-Forwarded-Host automatically — no explicit header_up needed.
{
	# Air-gap / local: internal CA only — never public ACME (TRD §1, ARCHITECTURE §13).
	# local_certs forces the internal CA for every cert (no ACME anywhere).
	# Admin API stays on localhost:2019 (used by the container healthcheck).
	auto_https disable_redirects
	local_certs
	# Serve the `proxy` cert to clients that omit SNI — Java/ZAP sends no SNI for
	# single-label hostnames, and without a default Caddy aborts the handshake
	# (alert 80), which broke the M0-SEC1 DAST-on-self baseline scan.
	default_sni proxy
	# HTTP/1.1 + HTTP/2 only — no HTTP/3. QUIC needs a large UDP receive buffer the
	# GitHub Actions runner won't grant ("failed to sufficiently increase receive
	# buffer size"), and Chromium migrating a navigation onto that starved QUIC
	# socket surfaced as intermittent `net::ERR_NETWORK_CHANGED` in the smoke e2e.
	# HTTP/2-over-TCP is stable in CI; no app behavior depends on h3.
	servers {
		protocols h1 h2
	}
}

# TR-24 security headers. Applied at the proxy so every route — web, API, errors —
# carries them regardless of upstream behavior.
#
# CSP is NOT set here: the web app owns its CSP via Next middleware (nonce-based,
# no script-src 'unsafe-inline') and the /api handle sets its own below. Setting a
# second CSP here would either overwrite the nonce policy or stack a permissive one
# — both defeat the nonce. Every other TR-24 header still applies to all routes.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# TR-24: strip server fingerprints; never emit deprecated X-XSS-Protection.
		# (Delete ops are automatically deferred until the upstream response arrives.)
		-Server
		-X-Powered-By
		-X-XSS-Protection
	}
}

# Bound to explicit hostnames so the internal CA mints matching certs on startup:
#   - localhost -> reached from the host at https://localhost (dev verification)
#   - proxy     -> reached in-network by Compose service name
# A bare `:443` site would fail the TLS handshake (no cert for the requested SNI).
localhost, proxy {
	tls internal
	import security_headers

	# Global request-body ceiling (SEC-DEBT-8): bound an unbounded body at the
	# single ingress so a giant/never-ending upload can't exhaust worker memory.
	# 128 MiB sits above the largest legitimate body — the 100 MiB source-archive
	# upload (services/source_archive.py MAX_UPLOAD_BYTES) plus multipart overhead;
	# per-endpoint caps stay the tighter, authoritative limits beneath this.
	request_body {
		max_size 128MiB
	}

	# handle_path strips the matched prefix (/api) before proxying; FastAPI's
	# root_path="/api" keeps generated URLs (docs, OpenAPI) prefix-aware.
	handle_path /api/* {
		# API CSP. The 'unsafe-inline' allowances exist ONLY for Swagger UI's
		# inline script/style, and Swagger is served only when EXPOSE_API_DOCS is
		# on (dev) — in prod (SEC-DEBT-7 fix) docs are unregistered, so /api serves
		# JSON only, where script-src is inert (JSON isn't a rendered document).
		# frame-ancestors 'none' keeps the clickjacking guard strict on every response.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}
}
